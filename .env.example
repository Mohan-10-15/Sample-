# ---------------------------------------------------------------------------
# Reverse Hackathon 2026 - environment
#
# Copy to .env.local for local work, or add these in Vercel -> Environment
# Variables. Never commit the filled-in version - .env* is gitignored.
# ---------------------------------------------------------------------------

# --- Organiser mailbox (Gmail SMTP) -----------------------------------------
# The confirmation email is sent AFTER the registration is saved, so an SMTP
# outage never loses an entry. If mail fails the form still succeeds.
#
# If the Gmail account has 2-Step Verification ON (it almost certainly does),
# the real password will NOT work here. Go to
# https://myaccount.google.com/apppasswords and generate a 16-character App
# Password, then use that as SMTP_PASS. No spaces, no quotes issues.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-organiser@gmail.com
SMTP_PASS=your-16-char-app-password

# Shown in the "From" line. Defaults to SMTP_USER when unset.
MAIL_FROM="Reverse Hackathon 2026 <your-organiser@gmail.com>"

# Optional. Comma-separated. Every confirmation is also copied here, so the
# organiser keeps their own record without opening the database dashboard.
MAIL_NOTIFY_TO=your-organiser@gmail.com

# --- Supabase server connection ----------------------------------------------
# Supabase Dashboard -> Connect / Settings -> API Keys.
# Keep the secret key only in Vercel Environment Variables. Never put the
# actual value in this file, the browser, or GitHub.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# Legacy projects may call this service_role; use only one of the two names.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# --- Organiser dashboard lock -----------------------------------------------
# Long random string. Required for /admin and every /api/admin/* route.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change-me-to-a-long-random-string